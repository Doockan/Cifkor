.main-container {
    flex-direction: column;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-items: stretch;
    background-color: rgb(250, 250, 250);
}

.tabs-container {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding: 20px 10px 10px 10px;
}

.tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
}

.tab-title {
    font-size: 24px;
    font-weight: bold;
    color: rgb(51, 102, 255);
    margin-bottom: 18px;
    text-align: center;
}

.clicker-topbar {
    width: 100%;
    height: auto;
    flex-direction: row;
    justify-content: space-between;
}

.currency-label {
    font-size: 18px;
    margin-bottom: 6px;
    color: rgb(51, 51, 51);
}

.energy-label {
    font-size: 18px;
    margin-bottom: 6px;
    color: rgb(51, 51, 51);
}

.clicker-button-container {
    width: 100%;
    justify-content: center;
    align-items: center;
    height: 100%;
}

.clicker-button {
    width: 140px;
    height: 140px;
    font-size: 20px;
    background-color: rgb(188, 188, 188);
    color: rgb(34, 34, 34);
    border-radius: 20px;
    margin-bottom: 14px;
    transition: background-color 0.2s;
    border-top-left-radius: 70px;
    border-top-right-radius: 70px;
    border-bottom-right-radius: 70px;
    border-bottom-left-radius: 70px;
    align-items: center;
    justify-content: center;
}

.clicker-vfx-container {
}

.currency-fly {
    position: absolute;
    left: 50%;
    top: 80%;    
    translate: 50% 50%;
    font-size: 32px;
    color: gold;
    opacity: 1;
    font-weight: bold;
    pointer-events: none;
    transition: top 3s, opacity 3s;
}
.currency-fly.fly {
    top: -100%;
    opacity: 0;
}

.clicker-particle {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(255, 255, 255);
    opacity: 1;
    transition: left 0.6s, top 0.6s, opacity 0.6s;
}

.clicker-button:active {
    background-color: rgb(255, 174, 0);
}

.weather-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
}

.weather-icon {
    width: 48px;
    height: 48px;
    margin-right: 16px;
}

.weather-label {
    font-size: 20px;
    color: rgb(0, 153, 204);
}

.dog-breeds-list {
    width: 95%;
    height: 220px;
    margin-top: 10px;
    background-color: rgb(238, 238, 238);
    border-radius: 10px;
}

.dog-fact-popup {
    position: absolute;
    left: 10%;
    top: 20%;
    width: 80%;
    min-height: 100px;
    background-color: rgb(255, 255, 255);
    border-radius: 14px;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.15);
    padding: 18px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.dog-fact-title {
    font-size: 21px;
    font-weight: bold;
    margin-bottom: 10px;
}

.dog-fact-description {
    font-size: 17px;
    margin-bottom: 10px;
    text-align: center;
    white-space: normal;
    word-break: break-word;
}

.dog-fact-close {
    width: 90px;
    height: 36px;
    background-color: rgb(204, 51, 51);
    color: rgb(255, 255, 255);
    border-radius: 8px;
}

.bottom-nav {
    flex-direction: row;
    width: 100%;
    height: 68px;
    align-items: center;
    justify-content: space-around;
    background-color: rgb(244, 244, 244);
    border-top: 2px solid rgb(238, 238, 238);
}

.nav-btn {
    flex-grow: 1;
    height: 48px;
    margin: 0 6px;
    font-size: 18px;
    background-color: rgb(238, 238, 238);
    color: rgb(68, 68, 68);
    border-radius: 12px;
    transition: background-color 0.2s;
}

.nav-btn.active {
    background-color: rgb(51, 102, 255);
    color: rgb(255, 255, 255);
}

.nav-btn:active {
    background-color: rgb(34, 68, 170);
}
