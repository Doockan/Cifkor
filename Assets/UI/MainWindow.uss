.main-container {
    flex-direction: column;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    align-items: stretch;
    background-color: #fafafa;
}

.tabs-container {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding: 20px 10px 10px 10px;
}

.tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
}

.tab-title {
    font-size: 24px;
    font-weight: bold;
    color: #3366ff;
    margin-bottom: 18px;
    text-align: center;
}

.clicker-button {
    width: 80%;
    height: 60px;
    font-size: 20px;
    background-color: #ffd700;
    color: #222;
    border-radius: 20px;
    margin-bottom: 14px;
    transition: background-color 0.2s;
}
.clicker-button:active {
    background-color: #ffae00;
}

.currency-label, .energy-label {
    font-size: 18px;
    margin-bottom: 6px;
    color: #333;
}

.weather-content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
}
.weather-icon {
    width: 48px;
    height: 48px;
    margin-right: 16px;
}
.weather-label {
    font-size: 20px;
    color: #0099cc;
}

.dog-breeds-list {
    width: 95%;
    height: 220px;
    margin-top: 10px;
    background-color: #eee;
    border-radius: 10px;
}
.dog-fact-popup {
    position: absolute;
    left: 10%;
    top: 20%;
    width: 80%;
    min-height: 100px;
    background-color: #fff;
    border-radius: 14px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.15);
    padding: 18px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.dog-fact-title {
    font-size: 21px;
    font-weight: bold;
    margin-bottom: 10px;
}
.dog-fact-description {
    font-size: 17px;
    margin-bottom: 10px;
    text-align: center;
}
.dog-fact-close {
    width: 90px;
    height: 36px;
    background-color: #c33;
    color: #fff;
    border-radius: 8px;
}

.bottom-nav {
    flex-direction: row;
    width: 100%;
    height: 68px;
    align-items: center;
    justify-content: space-around;
    background-color: #f4f4f4;
    border-top: 2px solid #eee;
}

.nav-btn {
    flex-grow: 1;
    height: 48px;
    margin: 0 6px;
    font-size: 18px;
    background-color: #eee;
    color: #444;
    border-radius: 12px;
    transition: background-color 0.2s;
}
.nav-btn.active {
    background-color: #3366ff;
    color: #fff;
}
.nav-btn:active {
    background-color: #2244aa;
}