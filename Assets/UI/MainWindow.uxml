<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/MainWindow.uss?fileID=7433441132597879392&amp;guid=7e052f00fea95624091fadb515021453&amp;type=3#MainWindow" />
    <ui:VisualElement class="main-container">
        <ui:VisualElement name="TabsContainer" class="tabs-container">
            <ui:VisualElement name="ClickerTab" class="tab clicker-tab">
                <ui:Label text="Кликер" class="tab-title" />
                <ui:Button name="ClickerButton" text="Кликнуть" class="clicker-button" />
                <ui:Label name="CurrencyLabel" text="Валюта: 0" class="currency-label" />
                <ui:Label name="EnergyLabel" text="Энергия: 1000" class="energy-label" />
            </ui:VisualElement>
            <ui:VisualElement name="WeatherTab" class="tab weather-tab" style="display: none;">
                <ui:Label text="Погода" class="tab-title" />
                <ui:VisualElement name="WeatherContent" class="weather-content">
                    <ui:Image name="WeatherIcon" class="weather-icon" />
                    <ui:Label name="WeatherLabel" text="Сегодня - 61F" class="weather-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="DogTab" class="tab dog-tab" style="display: none;">
                <ui:Label text="Породы и факты" class="tab-title" />
                <ui:ListView name="DogBreedsList" class="dog-breeds-list" />
                <ui:VisualElement name="DogFactPopup" class="dog-fact-popup" style="display: none;">
                    <ui:Label name="DogFactTitle" class="dog-fact-title" />
                    <ui:Label name="DogFactDescription" class="dog-fact-description" />
                    <ui:Button name="DogFactCloseButton" text="Закрыть" class="dog-fact-close" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="bottom-nav">
            <ui:Button name="TabClicker" text="Кликер" class="nav-btn active" />
            <ui:Button name="TabWeather" text="Погода" class="nav-btn" />
            <ui:Button name="TabDog" text="Собаки" class="nav-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
